# MGJ style — plain matplotlib stylesheet.
#
# This is the subset of the style that a .mplstyle file can express. It does
# NOT register the MGJ colormaps ('MGJ_Seq') and cannot hunt down Myriad on
# disk, so `import mgjstyle as mgj; mgj.use()` is still the complete option.
#
#   import mgjstyle, matplotlib.pyplot as plt
#   mgjstyle.install_mplstyle()      # once
#   plt.style.use("mgj")

font.family:        sans-serif
font.sans-serif:    Myriad Pro, Myriad, Source Sans 3, Source Sans Pro, Avenir Next, Avenir, Open Sans, Lato, PT Sans, Helvetica Neue, Arial, DejaVu Sans
font.size:          11
axes.labelsize:     11
axes.titlesize:     11.55
xtick.labelsize:    9.9
ytick.labelsize:    9.9
legend.fontsize:    9.9

figure.facecolor:   white
axes.facecolor:     white
savefig.facecolor:  white
figure.dpi:         200
savefig.dpi:        200
savefig.bbox:       tight

# the box: four spines, top and right as mirror axes (no ticks, no labels)
axes.spines.top:    True
axes.spines.right:  True
axes.spines.left:   True
axes.spines.bottom: True
axes.edgecolor:     201018
axes.linewidth:     1.0
axes.grid:          False

axes.labelweight:   bold
axes.labelcolor:    201018
axes.titleweight:   normal
axes.titlecolor:    201018
text.color:         201018

xtick.color:        201018
ytick.color:        201018
xtick.direction:    out
ytick.direction:    out
xtick.top:          False
ytick.right:        False
xtick.major.size:   4
ytick.major.size:   4
xtick.minor.size:   2
ytick.minor.size:   2
xtick.major.width:  1.0
ytick.major.width:  1.0

lines.linewidth:    1.6
lines.markersize:   5
legend.frameon:     False

axes.prop_cycle:    cycler('color', ['39143F', '0F69B5', '66A7C9', '818D29', 'FEC830', '960B00', '3A6260', '52051A', '8B9083'])
